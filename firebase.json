{
  "hosting": {
    "public": "dist",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/data/onet.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "site": "skills-bridge-pdx"
  }
}