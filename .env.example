# Copy to .env and fill in. NEVER commit .env — this repo is public.
# Load locally with:  node --env-file=.env server.js

# O*NET Web Services — register at https://services.onetcenter.org/
# Sends HTTP Basic Auth: username:password
ONET_USERNAME=
ONET_PASSWORD=

# CareerOneStop Web API — register at https://www.careeronestop.org/Developers/
# Sends Bearer token + userId in the URL path
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=

# Serve canned fixtures instead of hitting live APIs.
# Set MOCK=1 to build the frontend before credentials exist,
# and as the silent fallback if the network dies during the demo.
MOCK=1

PORT=3000
