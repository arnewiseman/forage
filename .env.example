# Everything works with NO credentials. This file is entirely optional.
#
#   npm start     # done. O*NET is local, jobs are live public APIs.
#
# The only thing a credential buys you is CareerOneStop's official skills-gap
# figures in place of our local O*NET importance diff. Nice to have, not needed.
#
# Load with:  node --env-file=.env server.js

# CareerOneStop Web API — https://www.careeronestop.org/Developers/
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=

# Force the local gap computation even if the above are set.
MOCK=0

PORT=3000
